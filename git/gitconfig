[user]
	name = Bradley Matola
	email = brmatola@gmail.com
[init]
	defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[push]
	autoSetupRemote = true
[core]
	editor = code --wait
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

# Identity for twiglylabs repos
[includeIf "gitdir:~/repos/twiglylabs/"]
	path = ~/.gitconfig-twiglylabs
